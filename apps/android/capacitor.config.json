{
  "appId": "com.sanorestaurant.app",
  "appName": "SANO Restaurant",
  "webDir": "android-shell",
  "server": {
    "url": "https://sano-restaurant.web.app",
    "androidScheme": "https",
    "errorPath": "index.html",
    "allowNavigation": ["sano-restaurant.web.app", "sano-restaurant.firebaseapp.com", "*.googleapis.com", "ve.dolarapi.com"]
  },
  "android": { "backgroundColor": "#0d0b09" },
  "plugins": {
    "SplashScreen": { "launchShowDuration": 900, "backgroundColor": "#0d0b09", "showSpinner": false, "androidScaleType": "CENTER_INSIDE" },
    "StatusBar": { "style": "DARK", "backgroundColor": "#0d0b09", "overlaysWebView": false }
  }
}
